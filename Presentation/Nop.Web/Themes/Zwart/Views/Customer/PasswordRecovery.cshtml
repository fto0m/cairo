@model PasswordRecoveryModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-password-recovery-page");
}

<div class="page password-recovery-page">
    <div class="products-list-header text-center text-uppercase">
        <h1 class="pt-3"> @T("Account.PasswordRecovery") </h1>
    </div>
    <div class="container">
        <div class="register-container border p-5 mt-4 mb-4">
            <div class="row">
                <div class="col-md-6 m-auto">
                    <div class="page-body">
                        <form asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" method="post">
                            <div asp-validation-summary="ModelOnly" class="message-error"></div>
                            <p class="tooltip">@T("Account.PasswordRecovery.Tooltip")</p>
                            <div class="fieldset">
                                <div class="">
                                    <div class="inputs">
                                        @*<label asp-for="Email" asp-postfix=":"></label>*@
                                        <input asp-for="Email" class="email w-100" placeholder="Your email address:" />
                                        <nop-required />
                                        <span asp-validation-for="Email"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="buttons">
                                <input type="submit" name="send-email" class="btn-info go-to-cart-button border-0 text-uppercase w-100" value="@T("Account.PasswordRecovery.RecoverButton")" />
                            </div>
                        </form>
                    </div>


                </div>
            </div>
            </div>
        </div>


</div>