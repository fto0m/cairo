@model List<MenuModel>

@using System.Linq

@{
    // Calculate equal column width for all menus
    // Newsletter takes col-lg-4, so menus share col-lg-8 (12 - 4 = 8)
    // Ensure all menus get equal width for proper spacing
    string GetColumnClass(int menuCount, int currentIndex)
    {
        if (menuCount == 0) return "";
        
        // For equal spacing, calculate proper Bootstrap column sizes
        if (menuCount == 1)
        {
            return "col-lg-4 col-md-6 col-sm-12 col-12";
        }
        else if (menuCount == 2)
        {
            return "col-lg-4 col-md-6 col-sm-12 col-12"; // Each gets 4 columns (4+4=8)
        }
        else if (menuCount == 3)
        {
            // For 3 menus: use 2, 3, 3 (2+3+3=8) - this matches original design
            return currentIndex == 0 ? "col-lg-2 col-md-6 col-sm-12 col-12" : "col-lg-3 col-md-6 col-sm-12 col-12";
        }
        else if (menuCount == 4)
        {
            return "col-lg-2 col-md-6 col-sm-12 col-12"; // Each gets 2 columns (2+2+2+2=8)
        }
        else
        {
            // For 5+ menus, use minimum 2 columns each
            // Calculate: 8 / menuCount, minimum 2
            var colsPerMenu = 8.0 / menuCount;
            var colSize = Math.Max(2, (int)Math.Floor(colsPerMenu));
            return $"col-lg-{colSize} col-md-6 col-sm-12 col-12";
        }
    }
    
    // Generate unique mobile class names based on menu index
    string GetMobileClass(int index)
    {
        var classes = new[] { "mobile-footer-information", "mobile-footer-service", "mobile-footer-service" };
        if (index < classes.Length)
            return classes[index];
        return $"mobile-footer-menu-{index}";
    }
}

@* Render all menus dynamically *@
@if (Model != null && Model.Any())
{
    var menuIndex = 0;
    
    @foreach (var menu in Model)
    {
        var menuId = $"footer-menu-{menu.Id}";
        var accordionId = $"accordion-menu-{menu.Id}";
        var collapseId = $"menu-body-{menu.Id}";
        var headerId = $"menu-header-{menu.Id}";
        var mobileClass = GetMobileClass(menuIndex);
        var columnClass = GetColumnClass(Model.Count, menuIndex);
        
        @* Desktop/Tablet Menu Column - Responsive with equal spacing *@
        <div class="@columnClass d-none d-lg-block @(menu.CssClass)">
            <div class="footer-nav-header">
                <h5 class="text-uppercase font-weight-bold"> <strong>@menu.Name</strong> </h5>
                <ul class="list footer-nav">
                    @foreach (var menuItem in menu.Items)
                    {
                        @await Html.PartialAsync("_FooterItem.cshtml", menuItem)
                    }
                </ul>
            </div>
        </div>
        
        @* Mobile Menu Column - Accordion Style *@
        <div class="@mobileClass col-12 d-block d-lg-none">
            <div id="@accordionId" class="@accordionId accordion md-accordion filter-section mb-2" role="tablist" aria-multiselectable="true">
                <div class="card bg-transparent">
                    <div class="card-header bg-transparent border-0 p-0" role="tab" id="@headerId">
                        <h5 class="mb-0 text-uppercase p-2" data-toggle="collapse" data-target="#@collapseId" aria-expanded="@(menuIndex == 1 ? "true" : "false")" aria-controls="@collapseId">
                            <strong>@menu.Name</strong>
                            <i class="fa fa-angle-down rotate-icon float-right"></i>
                        </h5>
                    </div>
                    <div id="@collapseId" class="collapse @(menuIndex == 1 ? "show" : "")" role="tabpanel" aria-labelledby="@headerId" data-parent="#@accordionId">
                        <div class="card-body">
                            <ul class="list footer-nav">
                                @foreach (var menuItem in menu.Items)
                                {
                                    @await Html.PartialAsync("_FooterItem.cshtml", menuItem)
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        menuIndex++;
    }
}
