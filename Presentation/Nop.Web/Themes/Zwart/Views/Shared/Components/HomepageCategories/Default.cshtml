@model IList<CategoryModel>

@using Nop.Core.Domain.Catalog

@if (Model.Count > 0)
{
    <div class="category-slider d-none category-add py-3 py-sm-3 mb-2" id="">
        <div class="custom-container-fluid pb-3 wow fadeInUp">
            <div class="row no-gutters">
                <div class="title title-container">
                    <h2> <strong> Categories </strong> </h2>
                </div>
                <div class="col-md-12 p-0">
                    <div class="owl-carousel owl-theme" id="category-adds">
                        @foreach (var item in Model)
                        {
                            <div class="item m-3">
                                <a class="d-block" href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = item.SeName }))" title="@item.PictureModel.Title">
                                    <img alt="@item.PictureModel.AlternateText" src="@item.PictureModel.ImageUrl" title="@item.PictureModel.Title" />
                                    <div class="category-add-text p-2 text-center text-uppercase"> @item.Name <i class="icon-right-arrow31"></i>  </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

