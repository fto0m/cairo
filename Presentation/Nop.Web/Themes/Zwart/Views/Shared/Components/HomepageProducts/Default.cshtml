@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
    <div class="featured-products-container d-none mt-5">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-3">
                    <div class="featured-products-box wow fadeInUp">
                        <div class="featured-box-text w-75">
                            <h2 class="text-uppercase"> <strong>@T("HomePage.Products")</strong> </h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-9">
                    <div class="owl-carousel owl-theme" id="featured-products">
                        @foreach (var item in Model)
                        {
                            <div class="item-box w-100">
                                @await Html.PartialAsync("_ProductBox", item)
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}