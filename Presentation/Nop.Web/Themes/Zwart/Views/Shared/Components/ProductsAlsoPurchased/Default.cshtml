@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
<div class="also-purchased-products-grid mb-5 thumb-list-slider d-none">
    <div class="col-md-12">
        <div class="title">
            <h2 class="title-container">  <span> <strong> @T("Products.AlsoPurchased") </strong> </span> </h2>
        </div>

        <div class="item-grid" id="also-purchased-products">
            @foreach (var item in Model)
            {
                <div class="item-box w-100 m-0"> @await Html.PartialAsync("_ProductBox", item) </div>
            }

        </div>
    </div>
</div>
}
