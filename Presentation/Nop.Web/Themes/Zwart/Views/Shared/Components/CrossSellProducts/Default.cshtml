@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
    <div class="cross-sells thumb-list-slider">



        <div class="container-fluid">
            <div class="row">


                <div class="col-md-12">

                    <div class="title">
                        <h2 class="text-uppercase mb-3 text-left">  <span> <strong>@T("ShoppingCart.CrossSells")</strong> </span> </h2>
                    </div>

                    <div class="owl-carousel owl-theme" id="featured-products">


                       @foreach (var product in Model)
                       {
                            <div class="item-box w-100 m-0"> @await Html.PartialAsync("_ProductBox", product) </div>
                        }

                    </div>
                </div>



            </div>
        </div>




    </div>

}

<script>
    $(document).ready(function () {
        $("#featured-products").owlCarousel({
            loop: false,
            margin: 10,
            nav: true,
            dots: false,
            lazyLoad: true,
            autoplay: false,
            smartSpeed: 300,

            navText: [
                "<i class='fa fa-angle-left'></i>",
                "<i class='fa fa-angle-right'></i>"
            ],

            responsive: {
                0: {
                    items: 1
                },
                576: {
                    items: 2
                },
                768: {
                    items: 3
                },
                992: {
                    items: 4
                },
                1500: {
                    items: 5
                }

            }
        });
    });

</script>



