@model ProductEmailAFriendModel

@using Nop.Core.Domain.Catalog

@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(Model.ProductName);
    //page class
    NopHtml.AddTitleParts(T("PageTitle.ProductEmailAFriend").Text);
    NopHtml.AppendPageCssClassParts("html-email-a-friend-page");
}
<div class="page email-a-friend-page">
    @*<div class="page-title">
    <h1> @T("Products.EmailAFriend.Title") </h1>
    </div>*@

    <div class="products-list-header text-center text-uppercase">
        <h1 class="pt-3"> @T("Products.EmailAFriend.Title") </h1>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-md-10 m-auto">
                <div class="register-container border p-5 mt-4 mb-4">

                    <div class="page-body">

                        @*<div class="title">
                        <h2><a href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.ProductSeName }))" class="product">@Model.ProductName</a></h2>
                        </div>*@

                        @if (Model.SuccessfullySent)
                        {
                        <div class="result">
                            @Model.Result
                        </div>
                        }
                        else
                        {
                            <form asp-route="@NopRouteNames.Standard.PRODUCT_EMAIL_FRIEND" method="post">
                            <div asp-validation-summary="ModelOnly" class="message-error"></div>
                            <div class="fieldset">
                                <div class="form-fields">
                                    <div class="inputs">
                                        @*<label asp-for="FriendEmail" asp-postfix=":"></label>*@
                                        <input asp-for="FriendEmail" class="friend-email w-100" placeholder="@T("Products.EmailAFriend.FriendEmail.Hint")" />
                                        <nop-required />
                                        <span asp-validation-for="FriendEmail"></span>
                                    </div>
                                    <div class="inputs">
                                        @*<label asp-for="YourEmailAddress" asp-postfix=":"></label>*@
                                        <input asp-for="YourEmailAddress" class="your-email w-100" placeholder="@T("Products.EmailAFriend.YourEmailAddress.Hint")" />
                                        <nop-required />
                                        <span asp-validation-for="YourEmailAddress"></span>
                                    </div>
                                    <div class="inputs">
                                        @*<label asp-for="PersonalMessage" asp-postfix=":"></label>*@
                                        <textarea asp-for="PersonalMessage" class="your-email w-100" placeholder="@T("Products.EmailAFriend.PersonalMessage.Hint")"></textarea>
                                        <nop-required />
                                        <span asp-validation-for="PersonalMessage"></span>
                                    </div>
                                    @if (Model.DisplayCaptcha)
                                    {
                                    <div class="captcha-box">
                                        <nop-captcha />
                                    </div>
                                    }
                                </div>
                            </div>
                            <div class="buttons">
                                <input type="submit" name="send-email" class="button-1 send-email-a-friend-button" value="@T("Products.EmailAFriend.Button")" />
                            </div>
                        </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
