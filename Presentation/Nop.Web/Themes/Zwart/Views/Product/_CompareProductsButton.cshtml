@model ProductDetailsModel
@{
    var addtocomparelink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_COMPARE, new
    {
        productId = Model.Id
    }
);
}
@if (Model.CompareProductsEnabled)
{
    <div class="compare-products">
        <button type="button" value="@T("Products.Compare.AddToCompareList")" class="w-100 button-2 text-center" onclick="AjaxCart.addproducttocomparelist('@addtocomparelink');return false;">
            <i class="fa fa-exchange" aria-hidden="true"></i>   @T("Products.Compare.AddToCompareList")
        </button>
    </div>
}